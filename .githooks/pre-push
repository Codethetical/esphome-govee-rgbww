#!/bin/sh
# Refuse to push a release tag whose tagged commit disagrees with the tag name.
#
# The failure this exists to prevent: cutting vX.Y.Z while the version
# references still say something else. That publishes a release whose README
# tells users to pin a source tag that does not exist, and whose firmware
# reports the wrong version in dump_config(). Fixing it afterwards means
# moving an already-published tag.
#
# Enable with:  git config core.hooksPath .githooks
#
# The actual rules live in scripts/check-release-version.sh, shared with the
# release-check workflow. This hook only decides which refs to run them on.

set -u

root=$(git rev-parse --show-toplevel) || exit 1
checker="$root/scripts/check-release-version.sh"

if [ ! -f "$checker" ]; then
  echo "pre-push: missing $checker - cannot validate release tags" >&2
  exit 1
fi

fail=0

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # Only release tags are subject to this; branches push normally.
  case "$local_ref" in
    refs/tags/v[0-9]*) ;;
    *) continue ;;
  esac

  # An all-zero local sha is a tag deletion - nothing to validate.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  tag=${local_ref#refs/tags/}
  commit=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null) || {
    echo "pre-push: $tag: cannot resolve tagged commit" >&2
    fail=1
    continue
  }

  sh "$checker" "$tag" "$commit" || fail=1
done

if [ "$fail" -ne 0 ]; then
  echo 'pre-push: refusing to push; nothing was sent.' >&2
  exit 1
fi

exit 0
